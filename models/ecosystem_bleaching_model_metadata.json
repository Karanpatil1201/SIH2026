{
  "model": "RandomForest ecosystem bleaching severity classifier",
  "features": [
    "sst_c",
    "ph",
    "species_observed",
    "marine_heatwave",
    "latitude",
    "longitude",
    "location"
  ],
  "target": "bleaching_severity",
  "metrics": {
    "accuracy": 0.29,
    "macro_f1": 0.2724,
    "records": 500,
    "train_rows": 400,
    "test_rows": 100,
    "classes": [
      "High",
      "Low",
      "Medium",
      "None"
    ]
  }
}