# ─── VARUNA Environment Variables Reference ──────────────────────────────────
# Copy this file to .env and fill in your real values.
# NEVER commit the .env file with actual credentials to git.

# ── 1. App Identity & Metadata ───────────────────────────────────────────────
PROJECT_NAME=VARUNA
PROJECT_TITLE=AI-Powered Marine Intelligence
TAGLINE=Transforming Marine Data into Intelligent Decisions.
VERSION=1.0.0

# ── 2. Server & Security ─────────────────────────────────────────────────────
ENVIRONMENT=development
PORT=8000
SECRET_KEY=your_super_secret_jwt_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── 3. Database & Supabase ───────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@db.your-supabase-id.supabase.co:5432/postgres
SUPABASE_URL=https://your-supabase-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ── 4. Marine & Meteorological Data Providers ────────────────────────────────
OPENMETEO_BASE_URL=https://marine-api.open-meteo.com/v1
OPENMETEO_WEATHER_URL=https://api.open-meteo.com/v1
COPERNICUS_API_URL=https://data.marine.copernicus.eu/api
COPERNICUS_USERNAME=your_copernicus_username
COPERNICUS_PASSWORD=your_copernicus_password

# ── 5. AI & Multi-Agent Intelligence ─────────────────────────────────────────
GEMINI_API_KEY=your_google_gemini_api_key
LLM_API_KEY=your_google_gemini_api_key
GEMINI_MODEL=gemini-2.0-flash
DEFAULT_OPERATIONAL_MODE=HYBRID
AGENT_ORCHESTRATION_MODE=HYBRID

# ── 6. Map & Geolocation Defaults ────────────────────────────────────────────
MAP_DEFAULT_LAT=18.9667
MAP_DEFAULT_LON=72.8333
MAP_DEFAULT_ZOOM=6

# ── 7. Multi-Channel Alerting - Email (SMTP) ─────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_email_app_password
SMTP_FROM_EMAIL=alerts@varuna.gov.in
SMTP_USE_TLS=true

# ── 8. Multi-Channel Alerting - SMS (Twilio) ─────────────────────────────────
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+1234567890

# ── 9. Push Notifications (Firebase Cloud Messaging) ─────────────────────────
FCM_SERVER_KEY=your_fcm_server_key
FCM_PROJECT_ID=varuna-1

# ── 10. Frontend Connection (Vercel) ─────────────────────────────────────────
# VITE_API_URL=https://your-backend.onrender.com/api
