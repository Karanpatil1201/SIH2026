# VARUNA Platform Environment Configurations

PROJECT_NAME=VARUNA
ENVIRONMENT=development
SECRET_KEY=your_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Settings
DATABASE_URL=sqlite:///./varuna.db

# Live External APIs
OPENMETEO_BASE_URL=https://marine-api.open-meteo.com/v1
OPENMETEO_WEATHER_URL=https://api.open-meteo.com/v1
COPERNICUS_USERNAME=your_copernicus_username
COPERNICUS_PASSWORD=your_copernicus_password
COPERNICUS_API_URL=https://cmems-catalog-ro.marine.copernicus.eu

# LLM / Agent Settings
LLM_API_KEY=your_gemini_api_key_here
AGENT_ORCHESTRATION_MODE=graph

# GIS & Map Settings
MAP_DEFAULT_LAT=18.9667
MAP_DEFAULT_LON=72.8333
MAP_DEFAULT_ZOOM=7

# Operation Mode: LIVE / DEMO / HYBRID
DEFAULT_OPERATIONAL_MODE=HYBRID

# ── Notification Services ──────────────────────────────────
# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_EMAIL=alerts@varuna.gov.in
SMTP_USE_TLS=True

# SMS (Twilio)
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+1234567890

# Push Notifications (Firebase Cloud Messaging)
FCM_SERVER_KEY=your_fcm_server_key
FCM_PROJECT_ID=varuna-1
